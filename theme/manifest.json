{
  "manifest_version": 2,
  "name": "Snoopy Vertical",
  "version": "1.4.2",
  "description": "Snoopy theme reworked for vertical tabs.",
  "theme": {
    "images": {
      "additional_backgrounds": ["images/header.png"]
    },
    "properties": {
      "additional_backgrounds_alignment": ["center top"],
      "additional_backgrounds_tiling": ["no-repeat"]
    },
    "colors": {
      "frame": "#fbf5e6",
      "frame_inactive": "#fbf5e6",
      "tab_background_text": "#5f5952",
      "tab_selected": "#ffffff",
      "tab_text": "#37352f",
      "tab_line": "#37352f",
      "toolbar": "rgba(255, 255, 255, 0)",
      "toolbar_text": "#5f5952",
      "toolbar_field": "rgba(255, 255, 255, 0)",
      "toolbar_field_text": "#37352f",
      "toolbar_field_border": "rgba(255, 255, 255, 0)",
      "toolbar_field_focus": "#ffffff",
      "toolbar_field_text_focus": "#37352f",
      "toolbar_field_border_focus": "#37352f",
      "toolbar_field_highlight": "rgba(246, 197, 68, 0.45)",
      "toolbar_field_highlight_text": "#37352f",
      "popup": "#ffffff",
      "popup_text": "#37352f",
      "popup_border": "#37352f",
      "toolbar_top_separator": "rgba(0, 0, 0, 0)",
      "toolbar_bottom_separator": "rgba(55, 53, 47, 0.09)",
      "sidebar": "#fbf5e6",
      "sidebar_text": "#37352f",
      "sidebar_border": "#e8dcc0",
      "sidebar_highlight": "#ffffff",
      "sidebar_highlight_text": "#37352f"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "snoopy-vertical@danielliew",
      "update_url": "https://raw.githubusercontent.com/danielliew/snoopy-firefox-theme/main/updates.json"
    }
  }
}
